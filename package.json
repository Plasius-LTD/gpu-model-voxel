{
  "name": "@plasius/gpu-model-voxel",
  "version": "0.1.0",
  "description": "Deterministic PVOX compilation, validation, CPU review rendering, and browser-safe decoding.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:privacy": "node --test tests/public-package-policy.test.cjs",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "audit:all": "npm run typecheck && npm run audit:eslint && npm run audit:deps && npm run audit:npm && npm run audit:test",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm run privacy:check && node scripts/verify-public-package.cjs",
    "privacy:check": "node scripts/verify-public-artifacts.cjs --source-only",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "pvox",
    "voxel",
    "webgpu",
    "3d-model",
    "path-tracing",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-model-voxel.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-model-voxel/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-model-voxel#readme",
  "dependencies": {
    "@plasius/asset-contracts": "^0.4.0",
    "@plasius/gpu-model-core": "^0.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.2",
    "minimatch": "^10.2.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "engines": {
    "node": ">=24"
  }
}
